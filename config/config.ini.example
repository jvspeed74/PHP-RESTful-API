[database]
; Database connection settings
; Override with environment variables: DB_HOST, DB_PORT, etc.
host = mariadb
port = 3306
database = f1_db
username = f1_user
password = f1_password
charset = utf8mb4
collation = utf8mb4_general_ci
driver = mysql

[app]
; Application settings
; Override with environment variables: APP_NAME, APP_ENV, etc.
name = F1 Management API
env = development
debug = true

[logging]
; Logging configuration
; Override with environment variables: LOG_LEVEL, LOG_PATH, etc.
level = debug
path = logs/app.log
channel = app
