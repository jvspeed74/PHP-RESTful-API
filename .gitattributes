# Create .gitattributes in project root
@"
# Auto-detect text files and normalize line endings to LF on checkin
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF on checkout
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
"@ | Out-File -FilePath .gitattributes -Encoding utf8 -NoNewline

# Remove BOM if present
$content = Get-Content .gitattributes -Raw
$utf8NoBom = New-Object System.Text.UTF8Encoding $false
[System.IO.File]::WriteAllText("$PWD\.gitattributes", $content, $utf8NoBom)
